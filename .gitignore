/target
**/*.rs.bk
*.pdb

# Local run artifacts: captured device transcripts and TUI logs.
# Golden fixtures live in tests/fixtures/ and are tracked.
/captures
/logs
*.sqlite
*.sqlite-journal

# The browser tests' Playwright, its Chromium and its output, installed
# by `make web-deps`.
/crates/smartclock-web/tests/browser/node_modules
/crates/smartclock-web/tests/browser/test-results
/crates/smartclock-web/tests/browser/playwright-report


# Local scratch that should outlive a reboot, unlike /tmp.
/tmp
