# Settings shared by every smartclockd instance.  See `smartclockd
# --help`.
#
# Every instance, smartclockd@<port>, reads this file.  Every line
# below is commented out and shows the built-in default.  Uncomment
# one only to change it, for every instance at once; a setting for
# one instance alone goes in its drop-in instead (`systemctl edit
# smartclockd@ttyUSB0`, an Environment= line), and a setting made
# here cannot be overridden there.

# The unit sets this from the instance name, /dev/<port>; set it here
# only to point every instance at the same thing, which is only ever
# the simulator.
#SMARTCLOCKD_DEVICE=/dev/<port>

# The rate the receiver is set to.  The 58503A accepts 1200, 2400, 9600
# or 19200 (097-59551-02 5-101); 4800, 38400, 57600 and 115200 can also
# be opened, to reach a receiver something else moved there.
#SMARTCLOCKD_BAUD=19200

# One log per receiver, <model>-<serial>.sqlite in this directory,
# opened once the receiver has answered *IDN?.  Set
# SMARTCLOCKD_DATABASE to a file instead to log every receiver seen on
# this port into that one file.
#SMARTCLOCKD_LOG_DIR=/var/lib/smartclockd

# The unit sets this from the instance name.
#SMARTCLOCKD_SOCKET=/run/smartclockd/<port>/socket

# Seconds between polls of each tier.  The medium tier reads the
# satellite counts, the oscillator, the condition registers and the
# holdover detail, one short step per turn so the fast tier keeps its
# one-second slot.  No tier reads the status screen; the sky view asks
# for it while it is open.
#SMARTCLOCKD_FAST=1.0
#SMARTCLOCKD_MEDIUM=10.0
#SMARTCLOCKD_SLOW=60.0

# What clients may send.  true or false; empty is rejected.
#SMARTCLOCKD_ALLOW_CONTROL=false
#SMARTCLOCKD_ALLOW_DANGEROUS=false
#SMARTCLOCKD_ALLOW_RAW=false

# Erase the receiver's own diagnostic log once every entry of it is
# copied here and the receiver reports it nearly full.  Irreversible.
# Its log holds 222 entries and then stops recording, so this is what
# gets a long-running unit logging again -- but on a unit somebody is
# investigating, that log is evidence.
#SMARTCLOCKD_ADOPT_LOG=false
