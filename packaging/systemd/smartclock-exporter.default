# Settings for smartclock-exporter.  See `smartclock-exporter --help`.
#
# Every line below is commented out and shows the built-in default.
# Uncomment one only to change it -- except the socket, which has no
# default and must be set.

#SMARTCLOCK_EXPORTER_LISTEN=127.0.0.1:9979

# REQUIRED.  The daemon instance to scrape; one exporter per daemon.
#SMARTCLOCK_EXPORTER_SOCKET=/run/smartclockd/<instance>/socket
