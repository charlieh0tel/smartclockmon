[Unit]
Description=SmartClock GPS receiver logging daemon
Documentation=https://github.com/ch/smartclockmon
# Nothing here names the adapter.  Every setting lives in
# /etc/default/smartclockd so that this unit needs no editing; the
# daemon reconnects by itself when a USB adapter re-enumerates, and
# Restart=always covers the cases it cannot.  To have systemd stop the
# daemon outright while the adapter is unplugged, add a drop-in with
# BindsTo= and After= naming your device unit.  See docs/running.md.

[Service]
Type=exec
EnvironmentFile=-/etc/default/smartclockd
ExecStart=/usr/bin/smartclockd
Restart=always
RestartSec=5

User=smartclockd
Group=smartclockd
# The receiver's port is owned by the dialout group.
SupplementaryGroups=dialout

# /var/lib/smartclockd for the log, /run/smartclockd for the socket.
StateDirectory=smartclockd
StateDirectoryMode=0750
RuntimeDirectory=smartclockd
# Group-readable so the operator can run the TUI unprivileged.  This is
# the whole of the authorization model: anyone who can open the socket
# may issue whatever the daemon allows.
RuntimeDirectoryMode=0750

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
