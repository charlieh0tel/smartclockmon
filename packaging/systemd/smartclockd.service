[Unit]
Description=SmartClock GPS receiver logging daemon
Documentation=https://github.com/charlieh0tel/smartclockmon
# Nothing here names the adapter.  Every setting lives in
# /etc/default/smartclockd so that this unit needs no editing; the
# daemon reconnects by itself when a USB adapter re-enumerates, and
# Restart= below covers the cases it cannot.  To have systemd stop the
# daemon outright while the adapter is unplugged, add a drop-in with
# BindsTo= and After= naming your device unit.  See docs/running.md.

StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=exec
EnvironmentFile=-/etc/default/smartclockd
ExecStart=/usr/bin/smartclockd
# on-failure, not always, with a limit: a bad setting in
# /etc/default/smartclockd makes the daemon exit at startup, and without
# a limit that is a restart every five seconds forever rather than a
# unit that lands in "failed" where the operator can see it.
Restart=on-failure
RestartSec=5
# clap exits 2 for a usage error, which here means the configuration is
# wrong -- SMARTCLOCKD_DEVICE unset, a baud the receiver cannot do, an
# allow flag that is not true or false.  Retrying cannot fix any of
# those, so fail once and stay failed where the operator sees it.  A
# runtime failure exits 1 and still restarts.
RestartPreventExitStatus=2

User=smartclockd
Group=smartclockd
# The receiver's port is owned by the dialout group.
SupplementaryGroups=dialout

# /var/lib/smartclockd for the log, /run/smartclockd for the socket.
StateDirectory=smartclockd
StateDirectoryMode=0750
RuntimeDirectory=smartclockd
# Group-readable so the operator can run the TUI unprivileged.  This is
# the whole of the authorization model: anyone who can open the socket
# may issue whatever the daemon allows.
RuntimeDirectoryMode=0750

ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
NoNewPrivileges=yes
ProtectKernelTunables=yes
ProtectControlGroups=yes
# AF_INET/AF_INET6 because --device also takes tcp://host:port, for a
# receiver on a serial-to-network adapter or for the simulator.
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
MemoryDenyWriteExecute=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
